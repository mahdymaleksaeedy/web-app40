{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app40",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fefe4a80-94a9-4e3a-a1b0-075fa665e9f7","database_name": "web-app40" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c9eeb9902e17412e89eaa62f66e61209" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
